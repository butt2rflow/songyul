+  // local patch 2026-10-27 (glove): visibility into ACL transmit credits
+#define ARDUINOBLE_CREDIT_PATCH 1
+  uint8_t pendingPkt() const { return _pendingPkt; }
+  uint8_t maxPkt() const { return _maxPkt; }
+  uint16_t creditReleases = 0;   // credits given back after 100 ms with no Number-of-Completed-Packets event
