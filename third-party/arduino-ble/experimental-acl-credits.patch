--- a/src/utility/HCI.cpp
+++ b/src/utility/HCI.cpp
@@ -637,4 +637,9 @@
 {
+  // local patch 2026-10-27: a lost Number-of-Completed-Packets event (e.g. dropped by a full HCI rx buffer) used to
+  // leak that credit for good: fewer packets in flight (the glove's stream fell from 30 to ~20 notifications/s until a
+  // reboot), and with all credits gone this loop would wait forever. After 100 ms with no credit back, release one.
+  unsigned long waitStart = millis();
   while (_pendingPkt >= _maxPkt) {
     poll();
+    if (_pendingPkt >= _maxPkt && millis() - waitStart > 100) { _pendingPkt--; creditReleases++; waitStart = millis(); }
   }
@@ -880,2 +885,3 @@
 
+  if (eventHdr->evt == EVT_DISCONN_COMPLETE) _pendingPkt = 0;   // local patch: the controller flushed them
   if (eventHdr->evt == EVT_DISCONN_COMPLETE)
